{
  "name": "tiktok-live-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "Production PWA for simulating a live audience with AI vision comments and Deepgram streaming speech context.",
  "license": "MIT",
  "author": "Live Simulator contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vkupyansky/live-simulator.git"
  },
  "bugs": {
    "url": "https://github.com/vkupyansky/live-simulator/issues"
  },
  "homepage": "https://github.com/vkupyansky/live-simulator#readme",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": "24.22.2",
    "pnpm": "11.13.1"
  },
  "scripts": {
    "api:build": "pnpm --filter @live/api build",
    "api:start": "pnpm --filter @live/api start",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "smoke:ai": "node tests/smoke/mistral-live.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && pnpm --filter @live/api typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.6.6",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/eslint-parser": "8.0.7",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.7",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.10",
    "ws": "8.21.1",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
